# RCSA Sovereign Runtime Environment Variables
PORT=3000
NODE_ENV=development
JWT_SECRET=nbe_rcsa_dev_secret_2026_change_in_prod
RCSA_DB_PATH=data/rcsa.db

# Local LLM (Ollama) & OpenAI-Compatible Configuration
# Install Ollama, then run:
#   ollama run qwen3:1.7b
#   ollama run qwen3.5:4b
# Leave OPENAI_BASE_URL / LLM_API_BASE_URL empty to run in deterministic offline mode.
MODEL_PROVIDER=openai_compatible
LLM_MODEL=qwen3.5:4b
OPENAI_BASE_URL=
OPENAI_API_KEY=ollama

# Legacy / Extended Aliases
LLM_API_BASE_URL=
LLM_API_KEY=ollama
QWEN_FAST_MODEL=qwen3:1.7b
QWEN_ACCURATE_MODEL=qwen3.5:4b